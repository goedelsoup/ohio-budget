{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ClassDefinition",
  "description": "A `<class>.ont.yml` file — the schema layer of the corpus.",
  "type": "object",
  "required": [
    "class",
    "description",
    "label"
  ],
  "properties": {
    "class": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "edges": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/EdgeDef"
      }
    },
    "foundational_type": {
      "description": "Omitted entirely when the corpus alignment is \"none\".",
      "anyOf": [
        {
          "$ref": "#/definitions/FoundationalType"
        },
        {
          "type": "null"
        }
      ]
    },
    "label": {
      "type": "string"
    },
    "properties": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/PropertyDef"
      }
    }
  },
  "definitions": {
    "Direction": {
      "type": "string",
      "enum": [
        "out",
        "in"
      ]
    },
    "EdgeDef": {
      "type": "object",
      "required": [
        "direction",
        "relationship",
        "target"
      ],
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "direction": {
          "$ref": "#/definitions/Direction"
        },
        "relationship": {
          "type": "string"
        },
        "target": {
          "description": "Name of the class on the other end.",
          "type": "string"
        }
      }
    },
    "FoundationalOntology": {
      "type": "string",
      "enum": [
        "bfo",
        "ufo"
      ]
    },
    "FoundationalType": {
      "type": "object",
      "required": [
        "ontology",
        "type"
      ],
      "properties": {
        "ontology": {
          "$ref": "#/definitions/FoundationalOntology"
        },
        "type": {
          "description": "UFO: kind | subkind | role | phase | relator | mode | quality | event | situation. BFO: continuant | occurrent | quality | disposition | role | ...",
          "type": "string"
        }
      }
    },
    "PropertyDef": {
      "type": "object",
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "type": {
          "$ref": "#/definitions/PropertyType"
        }
      }
    },
    "PropertyType": {
      "type": "string",
      "enum": [
        "string",
        "date",
        "ref",
        "text"
      ]
    }
  }
}
